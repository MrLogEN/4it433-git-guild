{
  "name": "Commit message format",
  "target": "branch",
  "source_type": "Repository",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": ["~ALL"],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "commit_message_pattern",
      "parameters": {
        "name": "Required commit message format",
        "operator": "regex",
        "negate": false,
        "pattern": "^(ingest|bronze|silver|dq|gov|sablony|ci|infra|docs|milnik)(\\([a-z0-9_-]+\\))?!?: \\S.{0,70}\\n?$"
      }
    }
  ]
}
